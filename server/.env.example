# --- Required for the app to run at all ---

# SQLite by default — zero setup, works immediately. Swap to a postgresql://
# URL (and change the datasource provider in prisma/schema.prisma) for
# production.
DATABASE_URL="file:./dev.db"

# Signs session cookies. The fallback in server/src/lib/auth.ts only exists
# so local dev works with zero config — always set a real random value
# (e.g. `openssl rand -hex 32`) before deploying anywhere real.
JWT_SECRET=

# Origin allowed to send credentialed requests (cookies) to this API.
CLIENT_URL=http://localhost:5173

PORT=8787

# --- Optional: everything below has a realistic mock and works with no
# keys set at all ---

# Enables real Claude-generated replies + itinerary edits. Without this,
# /api/chat falls back to the keyword-based mock intent engine.
ANTHROPIC_API_KEY=

# Enables live weather lookups. Without this, /api/weather returns a
# deterministic mock forecast. See server/src/services/weatherService.ts.
WEATHER_API_KEY=

# Enables live local events/activities. Without this, /api/events filters
# the mock destination data by time of day. See eventsService.ts.
EVENTS_API_KEY=
