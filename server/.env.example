# --- Required for the app to run at all ---

# SQLite by default — zero setup, works immediately. Swap to a postgresql://
# URL (and change the datasource provider in prisma/schema.prisma) for
# production.
DATABASE_URL="file:./dev.db"

# Signs session cookies. The fallback in server/src/lib/auth.ts only exists
# so local dev works with zero config — always set a real random value
# (e.g. `openssl rand -hex 32`) before deploying anywhere real.
JWT_SECRET=

# Origin allowed to send credentialed requests (cookies) to this API.
# capacitor://localhost and http://localhost (iOS/Android native shells) are
# always allowed in addition to this — see src/index.ts.
CLIENT_URL=http://localhost:5173

# Extra CORS origins, comma-separated. Useful for testing the iOS app on a
# physical device over your LAN, e.g.: http://192.168.1.23:5173
CORS_EXTRA_ORIGINS=

PORT=8787

# --- Optional: everything below has a realistic mock and works with no
# keys set at all ---

# Enables real AI-generated itineraries + edits, via OpenRouter
# (https://openrouter.ai/keys) — an OpenAI-compatible gateway in front of
# many models, including Claude. Without this, /api/chat falls back to the
# keyword-based mock intent engine, which only knows Rome/Lisbon/Kyoto.
OPENROUTER_API_KEY=

# Any OpenRouter model slug that supports tool/function calling, e.g.
# anthropic/claude-sonnet-4.5, openai/gpt-4o-mini, google/gemini-2.5-pro.
# See https://openrouter.ai/models — filter by "Tools" support.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Enables real forecasts via OpenWeatherMap (https://openweathermap.org/api,
# free tier). Without this, /api/weather returns a deterministic mock
# forecast. See server/src/services/weatherService.ts.
WEATHER_API_KEY=

# Enables real, dated event listings via the Ticketmaster Discovery API
# (https://developer.ticketmaster.com/, free tier — request an API key from
# your account's "Apps" page). Without this, /api/events (and the AI's
# "what's on tonight" answers) fall back to the mock destination data,
# which is only sensible for Rome/Lisbon/Kyoto. Ticketmaster's coverage
# skews toward North America/Europe. See server/src/services/eventsService.ts.
EVENTS_API_KEY=
